# Generated by Terraform (iac/inventory.tf) - do not edit by hand, run `terraform apply` instead.

[docker]
%{ for name, ip in lookup(hosts_by_role, "docker-host", {}) ~}
${name} ansible_host=${ip}
%{ endfor ~}

[control_plane]
%{ for name, ip in lookup(hosts_by_role, "k8s-master", {}) ~}
${name} ansible_host=${ip}
%{ endfor ~}

[workers]
%{ for name, ip in lookup(hosts_by_role, "k8s-worker", {}) ~}
${name} ansible_host=${ip}
%{ endfor ~}

[k8s:children]
control_plane
workers

[all:vars]
ansible_user=${ssh_user}
ansible_ssh_private_key_file=${ssh_private_key}
ansible_python_interpreter=/usr/bin/python3
