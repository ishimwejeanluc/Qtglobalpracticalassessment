# docker/.env - the single settings file for the docker/ folder (git-ignored, chmod 600).
#   cp docker/.env.example docker/.env && chmod 600 docker/.env
# Plain KEY=value lines: no quotes, no spaces around "=".
# On c3-docker-host: copy this file WITHOUT the DOCKERHUB_TOKEN line to ~/projecthub/.env (chmod 600).

# ---------- Images (used by scripts/*.sh and docker-compose.yml) ----------
DOCKERHUB_USER=your-dockerhub-username
# Immutable: never reused once pushed. Bump it to publish a new build.
IMAGE_TAG=1.0.0
# Docker Hub > Account settings > Personal access tokens > "Read & Write" (release scripts only)
DOCKERHUB_TOKEN=

# Official images
NGINX_IMAGE=nginx:1.30.7-alpine
MONGO_IMAGE=mongo:7.0.48
VALKEY_IMAGE=valkey/valkey:8.1.12-alpine

# ---------- Application secrets (letters/digits only: they go into the MongoDB URI) ----------
MONGO_ROOT_USER=projecthub
# openssl rand -hex 16
MONGO_ROOT_PASSWORD=change-me
MONGO_DB=projecthub
# openssl rand -hex 16
VALKEY_PASSWORD=change-me
# openssl rand -hex 32 (at least 32 characters)
JWT_SECRET=change-me-at-least-32-chars
SEED_ENABLED=true
